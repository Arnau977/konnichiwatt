<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- No WinForms designer in this project: designer-serialization warnings don't apply -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Konnichiwatt</AssemblyName>
    <RootNamespace>Konnichiwatt</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\konnichiwatt.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.4.2</Version>
    <Product>Konnichiwatt</Product>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Where the app looks for update.json. Empty = no self-update (dev builds). Set when publishing:
         dotnet publish ... -p:UpdateManifestUrl=https://.../update.json -->
    <UpdateManifestUrl Condition="'$(UpdateManifestUrl)' == ''"></UpdateManifestUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Konnichiwatt.Tests" />
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Konnichiwatt.CHANGELOG.md" />
    <AssemblyMetadata Include="UpdateManifestUrl" Value="$(UpdateManifestUrl)" />
    <AssemblyMetadata Include="UpdateManifestUrlBeta" Value="$(UpdateManifestUrlBeta)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>


